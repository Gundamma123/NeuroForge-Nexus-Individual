# =============================================================================
# NeuroForge Nexus — Backend environment variables
# =============================================================================
# HOW TO USE:
#   Spring Boot does NOT load .env files automatically.
#   Choose one of these approaches for local development:
#
#   Option 1 — IDE run config (recommended):
#     IntelliJ: Run/Debug Configurations → Environment variables → load from file
#     VS Code:  Add "envFile": "${workspaceFolder}/backend/.env" to launch.json
#
#   Option 2 — Shell export before running:
#     export $(grep -v '^#' backend/.env | xargs)
#     mvn spring-boot:run
#
#   Option 3 — Maven command line:
#     mvn spring-boot:run -Dspring-boot.run.jvmArguments="-DJWT_SECRET=... -D..."
#
# IMPORTANT:
#   Copy this file to backend/.env and fill in real values.
#   backend/.env is listed in .gitignore and must NEVER be committed.
# =============================================================================

# ---- Database ----
# Must match the MySQL instance you're connecting to.
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# Optional overrides (defaults are set in application.properties):
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/neuroforge_nexus?...
# SPRING_DATASOURCE_USERNAME=root

# ---- JWT ----
# Generate a strong random secret (minimum 32 characters / 256 bits).
# Example: openssl rand -hex 32
JWT_SECRET=replace_with_a_strong_random_secret_minimum_32_chars

# Optional: token lifetime in milliseconds (default 86400000 = 24 hours)
# JWT_EXPIRATION_MS=86400000

# ---- GitHub App Integration ----
# Find these in: https://github.com/settings/apps -> your app
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Webhook secret configured in your GitHub App's webhook settings.
GITHUB_APP_WEBHOOK_SECRET=replace_with_your_github_webhook_secret

# ---- Token Encryption ----
# Used to encrypt GitHub access tokens stored in the database.
# Generate: openssl rand -hex 32
# WARNING: Changing this value invalidates all stored GitHub tokens.
#          Users will need to reconnect their GitHub accounts.
APP_ENCRYPTION_SECRET=replace_with_a_strong_random_secret_minimum_32_chars