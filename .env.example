# =============================================================================
# NeuroForge Nexus — Docker Compose environment variables
# =============================================================================
# HOW TO USE:
#   Docker Compose automatically loads a file named exactly ".env" from the
#   same directory as docker-compose.yml (this project root).
#
#   Copy this file to .env (in the project root) and fill in real values:
#     cp .env.example .env
#
#   The root .env is listed in .gitignore and must NEVER be committed.
# =============================================================================

# ---- MySQL service ----
# These are used to initialise the MySQL container on first start.
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password
MYSQL_USER=springuser
MYSQL_PASSWORD=replace_with_strong_db_password

# ---- JWT ----
# Must match across the app container. Min 32 characters.
# Generate: openssl rand -hex 32
JWT_SECRET=replace_with_a_strong_random_secret_minimum_32_chars

# ---- GitHub App Integration ----
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_CLIENT_ID=your_github_app_client_id
GITHUB_APP_CLIENT_SECRET=your_github_app_client_secret
GITHUB_APP_WEBHOOK_SECRET=your_github_webhook_secret

# ---- Token Encryption ----
# Must be the same value used when the database was first populated.
# Generate: openssl rand -hex 32
APP_ENCRYPTION_SECRET=replace_with_a_strong_random_secret_minimum_32_chars
